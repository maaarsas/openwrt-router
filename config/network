
config interface 'loopback'
	option device 'lo'
	option proto 'static'
	list ipaddr '127.0.0.1/8'

config globals 'globals'
	option dhcp_default_duid '00040fbcb6e3d8764153a8981f4e35240093'
	option ula_prefix 'fd31:ee1:7bfe::/48'
	option packet_steering '1'

config device
	option name 'br-lan'
	option type 'bridge'
	list ports 'lan1'
	list ports 'lan2'
	list ports 'lan3'
	list ports 'lan4'

config interface 'lan'
	option device 'br-lan'
	option proto 'static'
	list ipaddr '192.168.10.1/24'
	option ip6assign '60'

config interface 'iot'
	option proto 'static'
	list ipaddr '192.168.2.1/24'

config interface 'wan'
	option device 'wan'
	option proto 'dhcp'
	option dns '1.1.1.1'

config interface 'wan6'
	option device 'wan'
	option proto 'dhcpv6'

